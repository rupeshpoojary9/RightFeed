# Optional: two-letter country code for goal search, e.g. IN. Results then follow
# what is relevant there, including local languages. Unset leans English.
YOUTUBE_REGION=

# Optional but recommended: lets RightFeed search YouTube by your goals and
# detect video length (to drop Shorts). Free: https://console.cloud.google.com
# -> enable "YouTube Data API v3" -> Credentials -> API key.
YOUTUBE_API_KEY=

# Optional: powers the AI judge, summaries, quizzes, flashcards, learning
# paths and weekly reflections. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Model for summaries, quizzes, flashcards, learning paths and reflections.
CLAUDE_MODEL=claude-opus-5-5

# Model for the judge that scores every incoming video (classification).
# It runs on many items per refresh, so it defaults to the cheapest model.
JUDGE_MODEL=claude-haiku-5-5

# Optional: score videos with Jev instead. https://typesafe.ai
# Set JUDGE_PROVIDER=jev to use it when both AI keys are present. Jev only does
# the scoring, so summaries, quizzes and paths still need ANTHROPIC_API_KEY.
TYPESAFE_API_KEY=
JUDGE_PROVIDER=
JEV_MODEL=jev-latest

# Optional: protect the app with a password (recommended if you host it online).
APP_PASSWORD=
