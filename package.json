{
  "name": "rightfeed",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "A distraction-free, growth-focused YouTube feed",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "refresh": "node scripts/refresh.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
